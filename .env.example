# Copie para .env e ajuste. O .env é gitignored: segredo não entra no repositório.
#   cp .env.example .env

# Postgres
POSTGRESUSER=carlos
POSTGRESPASSWORD=carlos
POSTGRESDB=rastreador

# RabbitMQ (mesmas credenciais usadas pelos três serviços .NET e pelo painel :15672)
RABBITMQDEFAULTUSER=carlos
RABBITMQDEFAULTPASS=carlos

# Notificador: para quem o "e-mail" fake é endereçado
NOTIFICACAODESTINATARIO=voce@exemplo.com
